---
interface Props {
  variant?: 'default' | 'on-dark';
  showText?: boolean;
  class?: string;
}
const { variant = 'default', showText = true, class: className = '' } = Astro.props;
const textColor = variant === 'on-dark' ? '#f4f3ff' : 'var(--ink)';
---

<span class:list={['logo', className]} data-variant={variant}>
  <svg class="logo__mark" width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
    <defs>
      <linearGradient id="ocia-g" x1="2" y1="4" x2="32" y2="30" gradientUnits="userSpaceOnUse">
        <stop stop-color="#5B34EF" />
        <stop offset="0.55" stop-color="#7C5CFF" />
        <stop offset="1" stop-color="#22D3EE" />
      </linearGradient>
    </defs>
    <rect x="1.25" y="1.25" width="31.5" height="31.5" rx="9" stroke="url(#ocia-g)" stroke-width="2.5" />
    <!-- red neuronal minimalista -->
    <line x1="9" y1="10" x2="17" y2="17" stroke="url(#ocia-g)" stroke-width="1.6" />
    <line x1="9" y1="24" x2="17" y2="17" stroke="url(#ocia-g)" stroke-width="1.6" />
    <line x1="17" y1="17" x2="25" y2="10" stroke="url(#ocia-g)" stroke-width="1.6" />
    <line x1="17" y1="17" x2="25" y2="24" stroke="url(#ocia-g)" stroke-width="1.6" />
    <circle cx="9" cy="10" r="2.6" fill="#5B34EF" />
    <circle cx="9" cy="24" r="2.6" fill="#7C5CFF" />
    <circle cx="17" cy="17" r="3.1" fill="url(#ocia-g)" />
    <circle cx="25" cy="10" r="2.6" fill="#22D3EE" />
    <circle cx="25" cy="24" r="2.6" fill="#22D3EE" />
  </svg>
  {
    showText && (
      <span class="logo__text" style={`color:${textColor}`}>
        <strong>OCIA</strong>
        <small>Olimpiada Chilena de IA</small>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }
  .logo__mark {
    flex: none;
  }
  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
    font-family: var(--font-display);
  }
  .logo__text strong {
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .logo__text small {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
  }
  .logo[data-variant='on-dark'] .logo__text small {
    color: var(--night-mute);
  }
</style>
