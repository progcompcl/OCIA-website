---
import Logo from './Logo.astro';
import { nav, site } from '../data/site.ts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="on-dark" />
      <p>{site.tagline}</p>
      <p class="site-footer__org">
        Organiza <a href={site.organizerUrl}>{site.organizer}</a>
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Pie de página">
      <h2>Secciones</h2>
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href="/contacto/">Contacto</a></li>
      </ul>
    </nav>

    <div class="site-footer__contact">
      <h2>Contacto</h2>
      <ul>
        <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><a href={site.social.instagram}>Instagram</a></li>
        <li><a href={site.social.github}>GitHub</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap site-footer__base">
    <p>&copy; {year} {site.longName}. Sitio en construcción.</p>
    <a href="https://ioai-official.org" class="site-footer__ioai">Olimpiada Internacional de IA ↗</a>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--grad-ink);
    color: var(--night-mute);
    padding-block: clamp(2.6rem, 6vw, 4rem) 1.4rem;
  }
  .site-footer__grid {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1.5fr 1fr 1fr;
  }
  .site-footer h2 {
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--night-ink);
    margin-bottom: 0.9rem;
  }
  .site-footer__brand p {
    margin-top: 0.9rem;
    max-width: 34ch;
    font-size: 0.92rem;
  }
  .site-footer__org {
    font-size: 0.85rem !important;
  }
  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.45rem;
  }
  .site-footer a {
    color: var(--night-mute);
    text-decoration: none;
    font-size: 0.92rem;
  }
  .site-footer a:hover {
    color: var(--night-ink);
  }
  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 2.6rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--night-line);
    font-size: 0.82rem;
  }
  @media (max-width: 720px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }
  }
</style>
