---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h1' | 'h2';
}
const { eyebrow, title, lead, align = 'start', as: Tag = 'h2' } = Astro.props;
---

<div class:list={['section-heading', `is-${align}`]}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag>{title}</Tag>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</div>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    max-width: 46rem;
  }
  .section-heading.is-center {
    align-items: center;
    text-align: center;
    margin-inline: auto;
  }
  .section-heading .lead {
    margin-top: 0.1rem;
  }
</style>
