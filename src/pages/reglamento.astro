---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import CtaBanner from '../components/CtaBanner.astro';
import Callout from '../components/Callout.astro';
import { faqs } from '../data/content.ts';
import { site } from '../data/site.ts';
---

<BaseLayout
  title="Reglamento"
  description="Reglamento de la OCIA y preguntas frecuentes sobre inscripción, categorías, fases y selección del equipo nacional."
>
  <PageHero
    eyebrow="Reglamento"
    title="Reglas y preguntas frecuentes"
    lead="El reglamento oficial define categorías, fases, criterios de avance y la selección del Equipo Chile. Aquí encontrarás un resumen y las dudas más habituales."
  />

  <section class="section">
    <div class="wrap wrap--narrow">
      <Callout title="Documento oficial">
        <p>
          El reglamento completo en PDF estará disponible aquí. <strong>TODO:</strong> enlazar el
          documento definitivo.
        </p>
        <p style="margin-top:0.8rem">
          <a class="btn btn--ghost" href={site.rulesPdf}>Descargar reglamento (PDF)</a>
        </p>
      </Callout>

      <h2 class="faq-title">Preguntas frecuentes</h2>
      <div class="faq">
        {
          faqs.map((f) => (
            <details class="faq__item">
              <summary>{f.q}</summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBanner />
</BaseLayout>

<style>
  .faq-title {
    margin: 2.6rem 0 1rem;
  }
  .faq {
    display: grid;
    gap: 0.6rem;
  }
  .faq__item {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--paper);
    padding: 0.2rem 1.1rem;
  }
  .faq__item summary {
    cursor: pointer;
    font-family: var(--font-display);
    font-weight: 600;
    padding: 0.9rem 0;
    list-style: none;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: '+';
    color: var(--brand-600);
    font-size: 1.2rem;
    line-height: 1;
  }
  .faq__item[open] summary::after {
    content: '−';
  }
  .faq__item p {
    padding: 0 0 1rem;
    color: var(--ink-soft);
  }
</style>
