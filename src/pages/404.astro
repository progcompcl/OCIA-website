---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Página no encontrada">
  <section class="section notfound">
    <div class="wrap wrap--narrow">
      <span class="eyebrow">Error 404</span>
      <h1>Esta página no existe</h1>
      <p class="lead">
        El enlace puede estar roto o la página fue movida. Vuelve al inicio para seguir explorando la
        OCIA.
      </p>
      <a class="btn btn--primary" href="/">Ir al inicio</a>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    text-align: center;
    padding-block: clamp(4rem, 12vw, 8rem);
  }
  .notfound .eyebrow {
    justify-content: center;
  }
  .notfound h1 {
    margin: 1rem 0;
  }
  .notfound .lead {
    margin: 0 auto 2rem;
  }
</style>
