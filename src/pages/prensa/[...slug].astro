---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias', ({ data }) => !data.draft);
  return noticias.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dateFmt = new Intl.DateTimeFormat('es-CL', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="article">
    <div class="wrap wrap--narrow">
      <a class="article__back" href="/prensa/">← Volver a prensa</a>
      <div class="article__meta">
        <span class="pill">{entry.data.tag}</span>
        <time datetime={entry.data.date.toISOString()}>{dateFmt.format(entry.data.date)}</time>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
      <div class="prose article__body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    padding-block: clamp(2.4rem, 6vw, 4rem);
  }
  .article__back {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .article__meta {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin: 1.6rem 0 0.8rem;
  }
  .article__meta time {
    font-size: 0.85rem;
    color: var(--ink-mute);
  }
  .article .lead {
    margin-top: 0.8rem;
  }
  .article__body {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
</style>
